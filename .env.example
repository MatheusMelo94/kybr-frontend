# Copy to .env.local (gitignored) and fill in. Validated by lib/env.ts;
# `pnpm build` and `pnpm start` fail on a missing or invalid value.
# There are no NEXT_PUBLIC_* variables: nothing here is inlined into the client bundle.
#
# The values below are for Local. Deployed values live in Vercel's environment
# variables, per environment (ADR-0005; docs/devops/vercel-setup.md):
#   Preview    = staging: every branch build; a placeholder API until backend staging exists
#   Production = https://api.kybr.com.br only, never a mock
# Pairing: Local -> local mock API, Preview -> mock API (backend staging once it
# exists), Production -> backend prod. Cross-wiring is a NO-GO.

# Kybr API base URL for calls from the Next.js server (Server Components, Server Actions).
# Public: no (server config).
#   Local:      the mock API from `pnpm mock:api`
#   Preview:    a placeholder https: URL (https://mock.example.invalid) until backend staging exists
#   Production: https://api.kybr.com.br
API_BASE_URL=http://localhost:4010

# Local and E2E only: lets a production build (`pnpm build` / `pnpm start`) use
# an http: API_BASE_URL on a loopback host, such as the mock API. Production
# otherwise requires https: (the BFF key travels on it). Public: no.
#   Local:      true
#   Preview:    never set (the deploy workflows fail if it is)
#   Production: never set (the deploy workflows fail if it is)
API_ALLOW_LOOPBACK_HTTP=true

# Kybr API base URL the browser uploads documents to (ADR-0004b). The server passes it
# to the upload component at runtime, and CSP connect-src allows its origin.
# Public: yes (not secret, visible to the browser). Must be https: in production
# (a loopback URL is accepted, for local production builds).
#   Local:      the mock API
#   Preview:    same origin as Preview API_BASE_URL
#   Production: https://api.kybr.com.br
API_PUBLIC_BASE_URL=http://localhost:4010

# Server-to-server key sent as X-Kybr-BFF-Key (contract X2).
# Public: NO, secret. Required in production builds, at least 32 characters.
#   Local:      optional (leave empty)
#   Preview:    its own value, never the Production one. Vercel "Sensitive".
#   Production: the backend's key. Vercel "Sensitive". Rotate quarterly.
API_BFF_KEY=

# Request header the hosting platform fills with the real client IP (contract X2).
# Public: no (server config). Required, with no default: it depends on the host
# (threat model F02). x-forwarded-for is list-valued. A platform header such as
# x-vercel-forwarded-for, x-real-ip or cf-connecting-ip is a single value.
#   Local:      x-forwarded-for (no proxy; with CLIENT_IP_TRUSTED_HOPS=1)
#   Preview:    x-vercel-forwarded-for (required on Vercel: lib/env-schema.ts)
#   Production: x-vercel-forwarded-for (required on Vercel: lib/env-schema.ts)
CLIENT_IP_HEADER=x-forwarded-for

# For a list-valued CLIENT_IP_HEADER only: how many trusted proxies append to it.
# The client's IP is the entry this many from the right; entries further left can
# be spoofed. Public: no. Required for x-forwarded-for, ignored otherwise.
#   Local:      1
#   Preview:    not set (x-vercel-forwarded-for is a single value)
#   Production: not set
CLIENT_IP_TRUSTED_HOPS=1

# Server-side error monitoring (T34a, threat model F10): the Sentry project's DSN.
# Sentry runs on the Node.js server only; the browser gets no SDK. Optional in
# every build, production included: unset, nothing is sent and the app works the
# same. Must be an https: URL. Public: no (server config; a DSN is not a secret,
# but keep it out of the client anyway).
#   Local:      not set
#   Preview:    the Preview Sentry project's DSN, or not set
#   Production: the Production Sentry project's DSN
SENTRY_DSN=
