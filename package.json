{
  "name": "kybr-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:secrets": "sh scripts/check-bundle-secrets.sh",
    "check:deploy-env": "node scripts/check-deploy-env.mjs",
    "check:deploy-headers": "sh scripts/check-deploy-headers.sh",
    "lhci": "pnpm --dir .github/deploy-tools install --frozen-lockfile --silent && .github/deploy-tools/node_modules/.bin/lhci autorun",
    "mock:api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/msw/mock-api.ts"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.5.27",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@faker-js/faker": "^10.6.0",
    "@mswjs/http-middleware": "^0.10.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
